  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'When the user on the current turn touches the location where the ball
    should be placed and places the ball, the player waits for the waiting time and
    then the turn passes to the other player.


    When magnetic balls collide with
    each other, Piece increases by the number of balls that hit the person whose
    turn it is.


    When one of the two''s Pieces becomes 0, the game ends and
    the first person to reach 0 wins.


    If the Max Turn is set and there is no
    winner until the Max Turn, the person with fewer Pieces at the Max Turn wins.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b11b6e42d723015438cf3603cd98f04a, type: 2}
  m_sharedMaterial: {fileID: -1190341943350534085, guid: b11b6e42d723015438cf3603cd98f04a,
    type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
